# Vaultstone Bank — server-side / seed-script secrets.
# Copy to `.env` and fill in real values. NEVER commit .env.

# Supabase project URL (same one used by the browser client; not secret)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon key — public, but kept here for Node scripts that simulate the browser
SUPABASE_ANON_KEY=

# Service-role JWT — bypasses ALL RLS. Used only by seed scripts and Edge Functions.
# Get it from: Supabase dashboard → Settings → API → service_role (secret).
# If this leaks, rotate it immediately via "Reset service_role secret".
SUPABASE_SERVICE_KEY=

# ── seed_hannah.mjs / verify_hannah.mjs ──────────────────────────
# Optional: pin the seeded user's password. If unset, seed_hannah.mjs generates
# a random 24-char password and prints it on completion.
HANNAH_PASSWORD=
HANNAH_EMAIL=hannah.baron2026@gmail.com
HANNAH_UID=ca34adc6-9673-4842-8153-5f9f0a638610
